<!DOCTYPE html>
<html>
<head>
    <title>Game Radar</title>
    <style>
        body {
            background-color: #0f172a;
            color: #ffffff;
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 20px;
        }
        h1 {
            color: #38bdf8;
            font-size: 36px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
        }
        .quiz-box, .review-box {
            background-color: #1e293b;
            border: 2px solid #38bdf8;
            border-radius: 12px;
            padding: 20px;
            margin: 20px 0;
            text-align: left;
        }
        select, input, textarea, button {
            width: 100%;
            padding: 10px;
            margin-top: 10px;
            border-radius: 6px;
            border: none;
            box-sizing: border-box;
        }
        select, input, textarea {
            background-color: #0f172a;
            color: #fff;
            border: 1px solid #334155;
        }
        button {
            background-color: #38bdf8;
            color: #0f172a;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
        }
        button:hover {
            background-color: #0284c7;
            color: #fff;
        }
        #quiz-result, #reviews-list {
            margin-top: 15px;
            background-color: #0f172a;
            padding: 12px;
            border-radius: 6px;
            border-left: 3px solid #38bdf8;
        }
        .user-review {
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid #334155;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>📡 Game Radar</h1>
        <p>Your interactive hub for top games & community reviews!</p>

        <!-- QUIZ SECTION -->
        <div class="quiz-box">
            <h2>🎮 Game Finder Quiz</h2>
            <label for="genreSelect">Choose your favorite genre:</label>
            <select id="genreSelect">
                <option value="adventure">Open World / Adventure</option>
                <option value="rpg">RPG / Action</option>
                <option value="shooter">Shooter / Action</option>
            </select>

            <label for="platformSelect">Preferred platform:</label>
            <select id="platformSelect">
                <option value="switch">Nintendo Switch</option>
                <option value="pc">PC / Mobile</option>
                <option value="all">Any Platform</option>
            </select>

            <button onclick="recommendGame()">Find My Game!</button>
            <div id="quiz-result">Answer the quiz above to get a tailored recommendation!</div>
        </div>

        <!-- REVIEW SECTION -->
        <div class="review-box">
            <h2>📝 Community Reviews</h2>
            <input type="text" id="gameName" placeholder="Game Title">
            <textarea id="reviewText" rows="3" placeholder="Write your review here..."></textarea>
            <button onclick="addReview()">Submit Review</button>

            <div id="reviews-list">
                <strong>Recent Reviews:</strong>
                <div class="user-review">
                    <strong>Zelda: Tears of the Kingdom</strong>
                    <p>Absolute masterpiece of an open world!</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function recommendGame() {
            const genre = document.getElementById('genreSelect').value;
            const resultBox = document.getElementById('quiz-result');

            let recommendation = "Minecraft - You can't go wrong with endless creative building!";

            if (genre === 'adventure') {
                recommendation = "Zelda: Tears of the Kingdom 🗡️ - An incredible open-world journey full of sky islands and creativity.";
            } else if (genre === 'rpg') {
                recommendation = "Genshin Impact ⚔️ - A vast action-RPG world with deep combat and exploration.";
            } else if (genre === 'shooter') {
                recommendation = "Apex Legends 🎯 - Fast-paced multiplayer action with unique character abilities.";
            }

            resultBox.innerHTML = `<strong>Recommended for you:</strong><br>${recommendation}`;
        }

        function addReview() {
            const game = document.getElementById('gameName').value;
            const text = document.getElementById('reviewText').value;

            if (game.trim() === '' || text.trim() === '') {
                alert('Please fill out both fields!');
                return;
            }

            const reviewsList = document.getElementById('reviews-list');
            const newReview = document.createElement('div');
            newReview.className = 'user-review';
            newReview.innerHTML = `<strong>${game}</strong><p>${text}</p>`;

            reviewsList.appendChild(newReview);

            document.getElementById('gameName').value = '';
            document.getElementById('reviewText').value = '';
        }
    </script>

</body>
</html>


