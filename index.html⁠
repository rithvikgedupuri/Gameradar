<!DOCTYPE html>
<html>
<head>
  <title>Game Radar</title>
  <style>
    body {
      background-color: #0f172a;
      color: #ffffff;
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 40px;
    }
    h1 {
      color: #38bdf8;
      font-size: 36px;
    }
    .card {
      background-color: #1e293b;
      border: 2px solid #38bdf8;
      border-radius: 12px;
      padding: 20px;
      max-width: 400px;
      margin: 20px auto;
    }
  </style>
</head>
<body>

  <h1>📡 Welcome to Game Radar!</h1>

  <div class="card">
    <h2>My Gaming Hub</h2>
    <p>Check back soon for awesome games, news, and builds!</p>
  </div>

</body>
</html>
